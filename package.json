{
  "name": "@selah/scripture-core",
  "version": "0.1.0",
  "description": "Shared Bible-reference detection, parsing, and Tiptap wiring for the Selah apps.",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tiptap": {
      "types": "./dist/tiptap/index.d.ts",
      "default": "./dist/tiptap/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "gen:verse-counts": "node scripts/gen-verse-counts.mjs > /tmp/vc.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test"
  },
  "peerDependencies": {
    "@tiptap/core": "^3",
    "@tiptap/pm": "^3",
    "@tiptap/react": "^3"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": { "optional": true },
    "@tiptap/pm": { "optional": true },
    "@tiptap/react": { "optional": true }
  },
  "devDependencies": {
    "@tiptap/core": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "typescript": "^5.6.0"
  }
}
